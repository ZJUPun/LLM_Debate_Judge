# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Local config / secrets ---
.env
*.key

# --- Temporary audit / scratch files ---
_audit/
*.tmp
*.bak

# --- Mock / offline-test artifacts (free fake-model runs, never real results) ---
# Mock call logs get a .mock suffix appended by dj/llm.py
logs/*.jsonl.mock
# Mock LLM cache is a separate sqlite file created only in DJ_MOCK=1 mode
cache/llm_cache.sqlite.mock
# Results folders beginning with _ are scratch/mock runs (e.g. results/_mock_math)
results/_*/

# --- Pycache inside subprojects ---
debate-judge-baseline/**/__pycache__/

# --- Run logs of background/one-off scripts ---
*.log
*.err
scripts/_*.py
